#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/validate_frontend_lifetime.pbs
#PBS -N owsm_beam_runtime
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ulimit -c 0
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/runtime-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export OWSM_PROFILE_PROGRESS="$OUT/progress.log"
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
# Exercise the error boundary against both the frozen old loop and the new drain.
PYTHONPATH="$PYTHONPATH:$LOCAL/tests" timeout 120 "$PY" - "$LOCAL" <<'PY_NEGATIVE' > "$LOCAL/results/stream_negative.log" 2>&1
import importlib.util
import json
import sys
from pathlib import Path
import test_stream_cleanup as check
p = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location('owsm_trt._stream_baseline', p/'baseline_runtime.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
check.GreedySession = mod.GreedySession
reproduced = []
for phase in ('launch', 'meanwhile', 'finished'):
    for priority in (False, True):
        try:
            check.test_failed_stream_drains_pending_work_and_can_be_reused('cuda', priority, phase)
        except AssertionError as exc:
            assert 'GPU work outlived' in str(exc), str(exc)
            reproduced.append([phase, priority])
        else:
            raise AssertionError('baseline did not expose pending GPU work')
(p/'results/stream_negative.json').write_text(json.dumps(reproduced)+'\n')
PY_NEGATIVE
timeout 300 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider \
    "$LOCAL/tests/test_stream_cleanup.py" "$LOCAL/tests/test_frontend_graph.py" \
    "$LOCAL/tests/test_frontend_options.py" "$LOCAL/tests/test_audio_prefetch.py" \
    "$LOCAL/tests/test_audio_io_profile.py" "$LOCAL/tests/test_audio_prefetch_options.py" \
    > "$LOCAL/results/tests.log" 2>&1
printf '%s\n' 'Stream exception negative control and focused regression tests complete' >> "$OUT/progress.log"
STATUS=0
timeout -k 15 120 "$PY" "$LOCAL/scripts/diagnose_frontend_lifetime.py" \
    --baseline-frontend "$LOCAL/baseline_frontend.py" --out "$LOCAL/results/pooled_lifetime" \
    > "$LOCAL/results/pooled_lifetime.log" 2>&1 || STATUS=$?
printf '%s\n' "$STATUS" > "$LOCAL/results/status_pooled_lifetime.txt"
timeout 120 "$PY" "$LOCAL/scripts/diagnose_frontend_lifetime.py" \
    --out "$LOCAL/results/exclusive_lifetime" > "$LOCAL/results/exclusive_lifetime.log" 2>&1
printf '%s\n' 'Pooled/exclusive frontend workspace lifetime diagnosis complete' >> "$OUT/progress.log"
for SIZE in 102m 1b; do
    NAME=owsm_v4_base_102M
    OPTIONS=(--workers 0 1 2 0 1 2 --reference "$LOCAL/prior_102m_api.json")
    if [ "$SIZE" = 1b ]; then
        NAME=owsm_v4_medium_1B
        OPTIONS=(--reference "$LOCAL/prior_1b_api.json")
    fi
    cp -a "$REPO/.cache/models/$NAME" "$LOCAL/$NAME"
    mkdir -p "$OWSM_TRT_CACHE/$NAME"
    cp -a "$REPO/.cache/engines/$NAME/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" "$OWSM_TRT_CACHE/$NAME/"
    timeout 600 "$PY" "$LOCAL/scripts/validate_audio_prefetch_api.py" \
        --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --long-audio "$LOCAL/long_110s.wav" \
        "${OPTIONS[@]}" --out "$LOCAL/results/${SIZE}_api" > "$LOCAL/results/${SIZE}_api.log" 2>&1
    printf '%s exclusive frontend public API validation complete\n' "$SIZE" >> "$OUT/progress.log"
    if [ "$SIZE" = 1b ]; then continue; fi
    for CORPUS in english japanese; do
        MANIFEST="$LOCAL/manifest.json"
        LANG_ID=eng
        if [ "$CORPUS" = japanese ]; then MANIFEST="$LOCAL/extra_manifest.json"; LANG_ID=jpn; fi
        timeout 500 "$PY" "$LOCAL/scripts/profile_audio_prefetch.py" \
            --model "$LOCAL/$NAME" --manifest "$MANIFEST" --lang "$LANG_ID" \
            --repeat 11 --out "$LOCAL/results/${SIZE}_${CORPUS}" > "$LOCAL/results/${SIZE}_${CORPUS}.log" 2>&1
        printf '%s %s missing prefetch timing comparison complete\n' "$SIZE" "$CORPUS" >> "$OUT/progress.log"
    done
    for BATCH in 1 8; do
        timeout 120 "$PY" "$LOCAL/scripts/profile_frontend_batches.py" \
            --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --lang eng \
            --warmup-reuse --memory-only "$BATCH" --memory-reverse \
            --out "$LOCAL/results/${SIZE}_memory_b${BATCH}" > "$LOCAL/results/${SIZE}_memory_b${BATCH}.log" 2>&1
    done
done
