#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/profile_finished_groups.pbs
#PBS -N owsm_beam_runtime
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ulimit -c 0
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/runtime-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export OWSM_PROFILE_PROGRESS="$OUT/progress.log"
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/models/owsm_v4_medium_1B" "$LOCAL/model"
# Preserve the model directory name used by the engine cache.
mv "$LOCAL/model" "$LOCAL/owsm_v4_medium_1B"
mkdir -p "$OWSM_TRT_CACHE/owsm_v4_medium_1B"
cp -a "$REPO/.cache/engines/owsm_v4_medium_1B/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" \
    "$OWSM_TRT_CACHE/owsm_v4_medium_1B/"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
cp "$LOCAL/baseline_runtime.py" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
timeout 300 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider \
    "$LOCAL/tests/test_finished_groups.py" "$LOCAL/tests/test_finished_skip.py" "$LOCAL/tests/test_greedy_select.py" "$LOCAL/tests/test_greedy_flags.py" \
    "$LOCAL/tests/test_lazy_plain.py" \
    > "$LOCAL/results/tests.log" 2>&1
printf '%s\n' 'Finished-group GPU graph/restart and greedy selection tests complete' >> "$OUT/progress.log"
timeout 180 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider "$LOCAL/tests/test_model.py" \
    -k 'beam or greedy or timestamp' > "$LOCAL/results/naive.log" 2>&1
printf '%s\n' 'Naive beam/greedy/timestamp regressions complete' >> "$OUT/progress.log"
for SIZE in 1b 102m; do
    MODEL="$LOCAL/owsm_v4_medium_1B"
    if [ "$SIZE" = 102m ]; then
        MODEL="$LOCAL/owsm_v4_base_102M"
        cp -a "$REPO/.cache/models/owsm_v4_base_102M" "$MODEL"
        mkdir -p "$OWSM_TRT_CACHE/owsm_v4_base_102M"
        cp -a "$REPO/.cache/engines/owsm_v4_base_102M/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" \
            "$OWSM_TRT_CACHE/owsm_v4_base_102M/"
    fi
    for CORPUS in english japanese; do
        MANIFEST="$LOCAL/manifest.json"
        LANG_ID=eng
        if [ "$CORPUS" = japanese ]; then
            MANIFEST="$LOCAL/extra_manifest.json"
            LANG_ID=jpn
        fi
        EXTRA=()
        if [ "$CORPUS" = english ]; then
            EXTRA=(--extra-checks --long-audio "$LOCAL/long_110s.wav")
        fi
        timeout 650 "$PY" "$LOCAL/scripts/profile_finished_skip.py" \
            --model "$MODEL" --manifest "$MANIFEST" --lang "$LANG_ID" --repeat 9 --group-skip \
            "${EXTRA[@]}" --out "$LOCAL/results/${SIZE}_${CORPUS}" \
            > "$LOCAL/results/${SIZE}_${CORPUS}.log" 2>&1
        printf '%s %s finished-group comparison complete\n' "$SIZE" "$CORPUS" >> "$OUT/progress.log"
    done
done

# Independent replication of the small exact1B B3 KV change; separate processes and no group-stop flag.
for CORPUS in english japanese; do
    MANIFEST="$LOCAL/manifest.json"
    LANG_ID=eng
    if [ "$CORPUS" = japanese ]; then MANIFEST="$LOCAL/extra_manifest.json"; LANG_ID=jpn; fi
    timeout 500 "$PY" "$LOCAL/scripts/profile_beam.py" \
        --model "$LOCAL/owsm_v4_medium_1B" --manifest "$MANIFEST" --lang "$LANG_ID" \
        --beam 5 --timestamps --batch 3 --chunk 4 --repeat 15 --limit 73 --upper-bound on \
        --fused-rank --fused-finish --fused-state --kv-reorder identity --share-cross-kv \
        --kv-identity-stats --baseline-runtime "$LOCAL/baseline_runtime.py" \
        --out "$LOCAL/results/kv_repeat_${CORPUS}" > "$LOCAL/results/kv_repeat_${CORPUS}.log" 2>&1
    printf '%s KVidentity B3 replication complete\n' "$CORPUS" >> "$OUT/progress.log"
done
"$PY" - "$LOCAL/results" <<'PYCODE'
import json
import sys
from pathlib import Path
root=Path(sys.argv[1])
for folder in root.glob('kv_repeat_*'):
    if not folder.is_dir(): continue
    records=json.loads((folder/'b3/tokens.json').read_text())
    assert records['baseline']==records['on'], folder
    rows=json.loads((folder/'b3/wall.json').read_text())
    calls={mode:{(r['repeat'],tuple(r['ids'])):r['decoder_calls'] for r in rows if r['mode']==mode}
           for mode in ('baseline','on')}
    assert calls['baseline']==calls['on'], folder
print('KVidentity replication full output and step checks complete')
PYCODE
