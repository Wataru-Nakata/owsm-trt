#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/profile_decoder_load.pbs
#PBS -N owsm_beam_runtime
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ulimit -c 0
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/runtime-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export OWSM_PROFILE_PROGRESS="$OUT/progress.log"
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/models/owsm_v4_medium_1B" "$LOCAL/model"
# Preserve the model directory name used by the engine cache.
mv "$LOCAL/model" "$LOCAL/owsm_v4_medium_1B"
mkdir -p "$OWSM_TRT_CACHE/owsm_v4_medium_1B"
cp -a "$REPO/.cache/engines/owsm_v4_medium_1B/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" \
    "$OWSM_TRT_CACHE/owsm_v4_medium_1B/"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
cp "$LOCAL/baseline_runtime.py" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
timeout 300 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider \
    "$LOCAL/tests/test_checkpoint_loading.py" "$LOCAL/tests/test_decoder_loading.py" \
    > "$LOCAL/results/tests.log" 2>&1
printf '%s\n' 'Checkpoint storage and empty decoder initialization tests complete' >> "$OUT/progress.log"
timeout 300 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider "$LOCAL/tests/test_model.py" \
    -k 'prefill_matches_incremental or greedy_session_matches_naive or beam_session_matches_naive_espnet or beam_of_one_is_greedy or timestamp_rules_greedy_and_beam' \
    > "$LOCAL/results/regressions.log" 2>&1
printf '%s\n' 'Decoder construction naive beam/greedy/timestamp regressions complete' >> "$OUT/progress.log"

timeout 1400 "$PY" "$LOCAL/scripts/profile_model_load.py" \
    --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
    --extra-manifest "$LOCAL/extra_manifest.json" --experiment decoder_skip --repeat 5 --out "$LOCAL/results/load1b" \
    > "$LOCAL/results/load1b.log" 2>&1
printf '%s\n' '1B model loading comparison complete' >> "$OUT/progress.log"
cp -a "$REPO/.cache/models/owsm_v4_base_102M" "$LOCAL/owsm_v4_base_102M"
mkdir -p "$OWSM_TRT_CACHE/owsm_v4_base_102M"
cp -a "$REPO/.cache/engines/owsm_v4_base_102M/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" \
    "$OWSM_TRT_CACHE/owsm_v4_base_102M/"
timeout 1200 "$PY" "$LOCAL/scripts/profile_model_load.py" \
    --model "$LOCAL/owsm_v4_base_102M" --manifest "$LOCAL/manifest.json" \
    --extra-manifest "$LOCAL/extra_manifest.json" --experiment decoder_skip --repeat 5 --out "$LOCAL/results/load102m" \
    > "$LOCAL/results/load102m.log" 2>&1
printf '%s\n' '102M model loading comparison complete' >> "$OUT/progress.log"

