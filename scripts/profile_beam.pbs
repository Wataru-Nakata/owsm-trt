#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/profile_beam.pbs
#PBS -N owsm_beam
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/beam-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/models/owsm_v4_medium_1B" "$LOCAL/model"
# Preserve the model directory name used by the engine cache.
mv "$LOCAL/model" "$LOCAL/owsm_v4_medium_1B"
mkdir -p "$OWSM_TRT_CACHE/owsm_v4_medium_1B"
cp -a "$REPO/.cache/engines/owsm_v4_medium_1B/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" \
    "$OWSM_TRT_CACHE/owsm_v4_medium_1B/"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
cp "$LOCAL/baseline_runtime.py" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
# Fail promptly on a correctness problem; do not benchmark a broken implementation.
timeout 480 "$PY" -m pytest -q -p no:cacheprovider "$LOCAL/tests/test_beam.py" \
    "$LOCAL/tests/test_beam_kernels.py" \
    "$LOCAL/tests/test_beam_reorder.py" \
    "$LOCAL/tests/test_beam_profile.py" \
    "$LOCAL/tests/test_model.py" "$LOCAL/tests/test_longform.py" \
    > "$LOCAL/results/tests.log" 2>&1
echo "beam and model regression tests passed"
printf '%s\n' 'regression tests passed' >> "$OUT/progress.log"
if [ "${EXPERIMENT:-stopping}" = splits ]; then
    timeout 900 "$PY" -m pytest -q -p no:cacheprovider "$LOCAL/tests/test_beam_cross.py" \
        "$LOCAL/tests/test_megakernel.py::test_ring_solo_is_bitwise_the_same" \
        > "$LOCAL/results/cross_tests.log" 2>&1
    printf '%s\n' 'cross-split regression tests passed' >> "$OUT/progress.log"
    for layout in independent grouped; do
        for slices in 2 4 8; do
            variant="${layout}_s${slices}"
            FLAGS=(--gluon-cross-splits "$slices")
            [ "$layout" != grouped ] || FLAGS+=(--gluon-group-queries)
            timeout 480 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
                --beam 5 --timestamps --batch 1 --chunk 1 --repeat 5 --limit "${PROFILE_LIMIT:-73}" \
                --upper-bound on --fused-rank --fused-finish --kv-reorder prefix --share-cross-kv \
                "${FLAGS[@]}" --baseline-runtime "$LOCAL/baseline_runtime.py" --phases --trace --disk \
                --extra-checks --long-audio "$LOCAL/long_110s.wav" \
                --out "$LOCAL/results/${variant}_b1" > "$LOCAL/results/${variant}_b1.log" 2>&1
            printf '%s English complete\n' "$variant" >> "$OUT/progress.log"
            if [ -n "${EXTRA_MANIFEST:-}" ]; then
                timeout 360 "$PY" "$LOCAL/scripts/profile_beam.py" \
                    --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
                    --lang "${EXTRA_LANG:?set second manifest language}" \
                    --beam 5 --timestamps --batch 1 --chunk 1 --repeat 3 \
                    --upper-bound on --fused-rank --fused-finish --kv-reorder prefix --share-cross-kv \
                    "${FLAGS[@]}" --baseline-runtime "$LOCAL/baseline_runtime.py" \
                    --out "$LOCAL/results/${variant}_japanese_b1" \
                    > "$LOCAL/results/${variant}_japanese_b1.log" 2>&1
                printf '%s Japanese complete\n' "$variant" >> "$OUT/progress.log"
            fi
        done
    done
    exit 0
fi
if [ "${EXPERIMENT:-stopping}" = cross ] || [ "${EXPERIMENT:-stopping}" = final ] || [ "${EXPERIMENT:-stopping}" = state ]; then
    timeout 900 "$PY" -m pytest -q -p no:cacheprovider "$LOCAL/tests/test_beam_cross.py" \
        "$LOCAL/tests/test_megakernel.py::test_ring_solo_is_bitwise_the_same" \
        "$LOCAL/tests/test_megakernel.py::test_backend_trial_falls_back" \
        > "$LOCAL/results/cross_tests.log" 2>&1
    printf '%s\n' 'shared cross KV and decoder regression tests passed' >> "$OUT/progress.log"
    STATE_FLAGS=()
    if [ "$EXPERIMENT" = state ]; then
        timeout 300 "$PY" -m pytest -q -p no:cacheprovider "$LOCAL/tests/test_beam_state.py" \
            > "$LOCAL/results/state_tests.log" 2>&1
        printf '%s\n' 'beam state fusion tests passed' >> "$OUT/progress.log"
        STATE_FLAGS+=(--fused-state)
    fi
    for batch in 1 3; do
        interval=4
        [ "$batch" != 1 ] || interval=1
        DETAIL=(--phases --trace --disk)
        [ "$batch" != 1 ] || DETAIL+=(--extra-checks --long-audio "$LOCAL/long_110s.wav")
        timeout 480 "$PY" "$LOCAL/scripts/profile_beam.py" \
            --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
            --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 5 \
            --limit "${PROFILE_LIMIT:-73}" --upper-bound on --fused-rank --fused-finish \
            --kv-reorder prefix --share-cross-kv "${STATE_FLAGS[@]}" --baseline-runtime "$LOCAL/baseline_runtime.py" \
            "${DETAIL[@]}" --out "$LOCAL/results/${EXPERIMENT}_b${batch}" \
            > "$LOCAL/results/${EXPERIMENT}_b${batch}.log" 2>&1
        printf 'shared cross KV batch %s complete\n' "$batch" >> "$OUT/progress.log"
        if [ -n "${EXTRA_MANIFEST:-}" ]; then
            timeout 360 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
                --lang "${EXTRA_LANG:?set the second manifest language}" \
                --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 3 \
                --upper-bound on --fused-rank --fused-finish --kv-reorder prefix --share-cross-kv "${STATE_FLAGS[@]}" \
                --baseline-runtime "$LOCAL/baseline_runtime.py" \
                --out "$LOCAL/results/${EXPERIMENT}_japanese_b${batch}" \
                > "$LOCAL/results/${EXPERIMENT}_japanese_b${batch}.log" 2>&1
            printf 'shared cross KV Japanese batch %s complete\n' "$batch" >> "$OUT/progress.log"
        fi
    done
    exit 0
fi
if [ "${EXPERIMENT:-stopping}" = decoder ]; then
    # R=5 uses Gluon; B=3/R=15 is outside the unchanged routing limit.
    for variant in p128 no_prefetch both; do
        FLAGS=()
        [ "$variant" = no_prefetch ] || FLAGS+=(--gluon-programs 128)
        [ "$variant" = p128 ] || FLAGS+=(--no-gluon-prefetch)
        timeout 480 "$PY" "$LOCAL/scripts/profile_beam.py" \
            --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
            --beam 5 --timestamps --batch 1 --chunk 1 --repeat 5 --limit "${PROFILE_LIMIT:-73}" \
            --upper-bound on --fused-rank --fused-finish --kv-reorder prefix "${FLAGS[@]}" \
            --baseline-runtime "$LOCAL/baseline_runtime.py" --phases --trace --disk \
            --extra-checks --long-audio "$LOCAL/long_110s.wav" \
            --out "$LOCAL/results/${variant}_b1" > "$LOCAL/results/${variant}_b1.log" 2>&1
        printf 'decoder %s batch 1 complete\n' "$variant" >> "$OUT/progress.log"
        if [ -n "${EXTRA_MANIFEST:-}" ]; then
            timeout 360 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
                --lang "${EXTRA_LANG:?set the second manifest language}" \
                --beam 5 --timestamps --batch 1 --chunk 1 --repeat 3 \
                --upper-bound on --fused-rank --fused-finish --kv-reorder prefix "${FLAGS[@]}" \
                --baseline-runtime "$LOCAL/baseline_runtime.py" \
                --out "$LOCAL/results/${variant}_japanese_b1" \
                > "$LOCAL/results/${variant}_japanese_b1.log" 2>&1
            printf 'decoder %s Japanese batch 1 complete\n' "$variant" >> "$OUT/progress.log"
        fi
    done
    exit 0
fi
if [ "${EXPERIMENT:-stopping}" = kv ]; then
    for variant in full prefix; do
        for batch in 1 3; do
            interval=4
            [ "$batch" != 1 ] || interval=1
            DETAIL=(--phases --trace --disk)
            [ "$batch" != 1 ] || DETAIL+=(--extra-checks --long-audio "$LOCAL/long_110s.wav")
            timeout 480 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
                --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 5 \
                --limit "${PROFILE_LIMIT:-73}" --upper-bound on --fused-rank --fused-finish \
                --kv-reorder "$variant" --baseline-runtime "$LOCAL/baseline_runtime.py" "${DETAIL[@]}" \
                --out "$LOCAL/results/${variant}_b${batch}" \
                > "$LOCAL/results/${variant}_b${batch}.log" 2>&1
            printf 'kv %s batch %s complete\n' "$variant" "$batch" >> "$OUT/progress.log"
            if [ -n "${EXTRA_MANIFEST:-}" ]; then
                timeout 360 "$PY" "$LOCAL/scripts/profile_beam.py" \
                    --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
                    --lang "${EXTRA_LANG:?set the second manifest language}" \
                    --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 3 \
                    --upper-bound on --fused-rank --fused-finish --kv-reorder "$variant" \
                    --baseline-runtime "$LOCAL/baseline_runtime.py" \
                    --out "$LOCAL/results/${variant}_japanese_b${batch}" \
                    > "$LOCAL/results/${variant}_japanese_b${batch}.log" 2>&1
                printf 'kv %s Japanese batch %s complete\n' "$variant" "$batch" >> "$OUT/progress.log"
            fi
        done
    done
    exit 0
fi
if [ "${EXPERIMENT:-stopping}" = fusion ]; then
    # Compare each independent kernel and their combination with the previous optimized runtime.
    # Every invocation alternates reference/changed order and warms its exact measured batches.
    for variant in finish rank both; do
        FLAGS=()
        [ "$variant" = rank ] || FLAGS+=(--fused-finish)
        [ "$variant" = finish ] || FLAGS+=(--fused-rank)
        for batch in 1 3; do
            interval=4
            [ "$batch" != 1 ] || interval=1
            DETAIL=()
            if [ "$variant" = both ]; then
                DETAIL+=(--phases --trace --disk)
                [ "$batch" != 1 ] || DETAIL+=(--extra-checks --long-audio "$LOCAL/long_110s.wav")
            fi
            timeout 480 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
                --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 5 \
                --limit "${PROFILE_LIMIT:-73}" --upper-bound on \
                --baseline-runtime "$LOCAL/baseline_runtime.py" "${FLAGS[@]}" "${DETAIL[@]}" \
                --out "$LOCAL/results/${variant}_b${batch}" \
                > "$LOCAL/results/${variant}_b${batch}.log" 2>&1
            echo "fusion $variant batch $batch complete"
        done
    done
    if [ -n "${EXTRA_MANIFEST:-}" ]; then
        for batch in 1 3; do
            interval=4
            [ "$batch" != 1 ] || interval=1
            timeout 360 "$PY" "$LOCAL/scripts/profile_beam.py" \
                --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
                --lang "${EXTRA_LANG:?set the second manifest language}" \
                --beam 5 --timestamps --batch "$batch" --chunk "$interval" --repeat 3 \
                --upper-bound on --fused-rank --fused-finish \
                --baseline-runtime "$LOCAL/baseline_runtime.py" \
                --out "$LOCAL/results/japanese_b${batch}" \
                > "$LOCAL/results/japanese_b${batch}.log" 2>&1
            echo "fusion Japanese batch $batch complete"
        done
    fi
    exit 0
fi
EXTRA=()
if [ -n "${COMPARE_CHUNKS:-}" ]; then
    IFS=: read -r -a CHUNKS <<< "$COMPARE_CHUNKS"
    EXTRA+=(--compare-chunks "${CHUNKS[@]}")
fi
timeout 2600 "$PY" "$LOCAL/scripts/profile_beam.py" \
    --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/manifest.json" \
    --beam 5 --timestamps --batch 1 3 --repeat 5 --limit "${PROFILE_LIMIT:-12}" --upper-bound both \
    --baseline-runtime "$LOCAL/baseline_runtime.py" --phases --trace --disk \
    --extra-checks --long-audio "$LOCAL/long_110s.wav" --out "$LOCAL/results/profile" "${EXTRA[@]}" \
    > "$LOCAL/results/profile.log" 2>&1
echo "beam profile complete"
if [ -n "${EXTRA_MANIFEST:-}" ]; then
    timeout 600 "$PY" "$LOCAL/scripts/profile_beam.py" \
        --model "$LOCAL/owsm_v4_medium_1B" --manifest "$LOCAL/extra_manifest.json" \
        --lang "${EXTRA_LANG:?set the second manifest language}" \
        --beam 5 --timestamps --batch 1 3 --repeat 3 --upper-bound both \
        --baseline-runtime "$LOCAL/baseline_runtime.py" --out "$LOCAL/results/extra_profile" \
        > "$LOCAL/results/extra_profile.log" 2>&1
    echo "additional-language profile complete"
fi
