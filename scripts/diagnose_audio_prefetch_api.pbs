#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/diagnose_audio_prefetch_api.pbs
#PBS -N owsm_beam_runtime
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ulimit -c 0
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/runtime-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export OWSM_PROFILE_PROGRESS="$OUT/progress.log"
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
# Audio runtime/options are unchanged: retain the48 passing test results from2776966.
cp "$LOCAL/prior_audio_tests.log" "$LOCAL/results/prior_audio_tests.log"
# LSE is independent of audio, so record its status and continue to the primary CUDA diagnosis.
LSE_STATUS=0
if PYTHONPATH="$PYTHONPATH:$LOCAL/tests" timeout 180 "$PY" "$LOCAL/scripts/diagnose_beam_lse.py" \
    --out "$LOCAL/results/lse_diagnostic.json" > "$LOCAL/results/lse_diagnostic.log" 2>&1; then
    printf '0\n' > "$LOCAL/results/lse_diagnostic_status.txt"
else
    STATUS=$?
    printf '%s\n' "$STATUS" > "$LOCAL/results/lse_diagnostic_status.txt"
    LSE_STATUS=1
fi
if timeout 300 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider \
    "$LOCAL/tests/test_beam_lse.py" "$LOCAL/tests/test_beam.py" \
    "$LOCAL/tests/test_beam_kernels.py" "$LOCAL/tests/test_beam_state.py" \
    > "$LOCAL/results/lse_tests.log" 2>&1; then
    printf '0\n' > "$LOCAL/results/lse_tests_status.txt"
else
    STATUS=$?
    printf '%s\n' "$STATUS" > "$LOCAL/results/lse_tests_status.txt"
    LSE_STATUS=1
fi
timeout 180 "$PY" -m pytest -vv -x --tb=short -p no:cacheprovider "$LOCAL/tests/test_model.py" \
    -k 'beam or greedy or timestamp' > "$LOCAL/results/naive.log" 2>&1
printf '%s\n' 'Independent LSE diagnosis/test phases recorded; naive regressions complete' >> "$OUT/progress.log"
NAME=owsm_v4_base_102M
cp -a "$REPO/.cache/models/$NAME" "$LOCAL/$NAME"
mkdir -p "$OWSM_TRT_CACHE/$NAME"
cp -a "$REPO/.cache/engines/$NAME/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" "$OWSM_TRT_CACHE/$NAME/"
# Debug synchronization changes execution timing; never use these passes as speed evidence.
CUDA_LAUNCH_BLOCKING=1 timeout 450 "$PY" "$LOCAL/scripts/validate_audio_prefetch_api.py" \
    --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --long-audio "$LOCAL/long_110s.wav" \
    --workers 2 --reference "$LOCAL/prior_102m_api.json" --sync-cases \
    --out "$LOCAL/results/102m_blocking_api" > "$LOCAL/results/102m_blocking_api.log" 2>&1
printf '%s\n' '102M worker2 blocking/synchronized diagnostic passed' >> "$OUT/progress.log"
timeout 450 "$PY" "$LOCAL/scripts/validate_audio_prefetch_api.py" \
    --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --long-audio "$LOCAL/long_110s.wav" \
    --reference "$LOCAL/prior_102m_api.json" \
    --out "$LOCAL/results/102m_async_api" > "$LOCAL/results/102m_async_api.log" 2>&1
printf '%s\n' '102M asynchronous0/1/2 API sequence passed' >> "$OUT/progress.log"
for CORPUS in english japanese; do
    MANIFEST="$LOCAL/manifest.json"
    LANG_ID=eng
    if [ "$CORPUS" = japanese ]; then MANIFEST="$LOCAL/extra_manifest.json"; LANG_ID=jpn; fi
    timeout 500 "$PY" "$LOCAL/scripts/profile_audio_prefetch.py" \
        --model "$LOCAL/$NAME" --manifest "$MANIFEST" --lang "$LANG_ID" \
        --repeat 11 --out "$LOCAL/results/102m_${CORPUS}" > "$LOCAL/results/102m_${CORPUS}.log" 2>&1
    printf '102M %s file-inclusive prefetch replication complete\n' "$CORPUS" >> "$OUT/progress.log"
done
exit "$LSE_STATUS"
