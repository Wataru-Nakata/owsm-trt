#!/bin/bash
# Submit only after confirming group, reservation, resource and node/GPU counts.
# qsub -P <group> -q <reservation> -v RTYPE=rt_HG,SNAPSHOT=<absolute tar path> \
#   -l select=1 -l walltime=01:00:00 scripts/diagnose_prefetch_cuda_matrix.pbs
#PBS -N owsm_beam_runtime
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
ulimit -c 0
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
: "${SNAPSHOT:?immutable source archive prepared before submission}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/runtime-${PBS_JOBID%%.*}"
LOCAL="$PBS_LOCALDIR/beam"
mkdir -p "$OUT" "$LOCAL" "$LOCAL/results" "$LOCAL/tmp" "$LOCAL/engines"
export TMPDIR="$LOCAL/tmp" TRITON_CACHE_DIR="$LOCAL/triton" TORCHINDUCTOR_CACHE_DIR="$LOCAL/inductor"
export XDG_CACHE_HOME="$LOCAL/cache" CUDA_CACHE_PATH="$LOCAL/cuda"
export OWSM_TRT_CACHE="$LOCAL/engines" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export OWSM_PROFILE_PROGRESS="$OUT/progress.log"
SMI=""
publish() {
    local status=$?
    trap - EXIT
    [ -z "$SMI" ] || kill "$SMI" 2>/dev/null || true
    printf '%s\n' "$status" > "$LOCAL/results/exit_status.txt"
    cp -a "$LOCAL/results/." "$OUT/"
    exit "$status"
}
trap publish EXIT
ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
"$ZSTD" -dc -T4 "$REPO/.cache/envs/owsm-env.tar.zst" | tar -xf - -C "$PBS_LOCALDIR"
tar -xf "$SNAPSHOT" -C "$LOCAL"
export OWSM_PROFILE_COMMIT="$(cat "$LOCAL/commit.txt")"
cp -a "$REPO/.cache/testdata/librispeech_dummy" "$LOCAL/data"
cp "$REPO/.cache/testdata/long_110s.wav" "$LOCAL/long_110s.wav"
export PYTHONPATH="$LOCAL/src:$LOCAL/scripts"
PY="$PBS_LOCALDIR/owsm-env/bin/python3"
"$PY" - "$LOCAL" "${EXTRA_MANIFEST:-}" "${EXTRA_LIMIT:-12}" <<'PY'
import json
import shutil
import sys
from pathlib import Path
p = Path(sys.argv[1])
items = json.loads((p / 'data/manifest.json').read_text())
for item in items:
    item['path'] = str(p / 'data' / Path(item['path']).name)
(p / 'manifest.json').write_text(json.dumps(items))
if sys.argv[2]:
    extra = json.loads(Path(sys.argv[2]).read_text())[:int(sys.argv[3])]
    (p / 'extra_audio').mkdir()
    for item in extra:
        source = Path(item['path'])
        dest = p / 'extra_audio' / (item['id'] + source.suffix)
        shutil.copyfile(source, dest)
        item['path'] = str(dest)
    (p / 'extra_manifest.json').write_text(json.dumps(extra))
PY
cp "$LOCAL/source.json" "$LOCAL/results/"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 \
    > "$LOCAL/results/gpu_utilization.csv" &
SMI=$!
# The completed48 audio,149 LSE/beam and31 naive tests are retained in earlier artifacts.
NAME=owsm_v4_base_102M
cp -a "$REPO/.cache/models/$NAME" "$LOCAL/$NAME"
mkdir -p "$OWSM_TRT_CACHE/$NAME"
cp -a "$REPO/.cache/engines/$NAME/v621-NVIDIA_H200-sm90-trt11.4.0.106-float16-3d0cbdc9" "$OWSM_TRT_CACHE/$NAME/"
for MODE in fresh2 zero3 legacy eager sync; do
    OPTIONS=()
    case "$MODE" in
        fresh2) OPTIONS=(--workers 2);;
        zero3) OPTIONS=(--workers 0 0 0);;
        legacy) OPTIONS=(--legacy-frontend-warmup);;
        eager) OPTIONS=(--frontend-eager);;
        sync) OPTIONS=(--sync-cases);;
    esac
    STATUS=0
    timeout -k 15 450 "$PY" "$LOCAL/scripts/validate_audio_prefetch_api.py" \
        --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --long-audio "$LOCAL/long_110s.wav" \
        --reference "$LOCAL/prior_102m_api.json" "${OPTIONS[@]}" \
        --out "$LOCAL/results/$MODE" > "$LOCAL/results/$MODE.log" 2>&1 || STATUS=$?
    printf '%s\n' "$STATUS" > "$LOCAL/results/status_$MODE.txt"
    printf 'CUDA diagnosis %s completed, exit=%s\n' "$MODE" "$STATUS" >> "$OUT/progress.log"
done
SANITIZER=/apps/cuda/13.0.1/bin/compute-sanitizer
STATUS=0
if [ -x "$SANITIZER" ]; then
    "$SANITIZER" --version > "$LOCAL/results/sanitizer_version.txt" 2>&1
    timeout -k 15 600 "$SANITIZER" --tool memcheck --track-stream-ordered-races all \
        --error-exitcode 86 --log-file "$LOCAL/results/memcheck.log" \
        "$PY" "$LOCAL/scripts/validate_audio_prefetch_api.py" \
        --model "$LOCAL/$NAME" --manifest "$LOCAL/manifest.json" --long-audio "$LOCAL/long_110s.wav" \
        --reference "$LOCAL/prior_102m_api.json" \
        --out "$LOCAL/results/memcheck" > "$LOCAL/results/memcheck_app.log" 2>&1 || STATUS=$?
else
    STATUS=127
fi
printf '%s\n' "$STATUS" > "$LOCAL/results/status_memcheck.txt"
printf 'CUDA memcheck completed, exit=%s\n' "$STATUS" >> "$OUT/progress.log"
"$PY" - "$LOCAL/results" <<'PY_STATUS'
import json
import sys
from pathlib import Path
p=Path(sys.argv[1])
statuses={x.stem.removeprefix('status_'):int(x.read_text()) for x in p.glob('status_*.txt')}
assert set(statuses)=={'fresh2','zero3','legacy','eager','sync','memcheck'}
(p/'matrix.json').write_text(json.dumps({'statuses':statuses,'scope':'Independent diagnostics; exit0 here means matrix execution completed, not every mode passed. No speed measurements.'},indent=2)+'\n')
PY_STATUS
